PORT=8787
BASE_URL=http://localhost:8787
CHAIN_ID=56
# For real paid routes, enable B402 and set B402_* credentials plus a real pay-to wallet.
PAYMENTS_ENABLED=false
PAYMENT_RECIPIENT=
PAYMENT_TOKEN_ADDRESS=
PAYMENT_AMOUNT_ATOMIC=20000000000000000
PAYMENT_TRANSFER_METHOD=eip3009
PAYMENT_TOKEN_NAME=United Stables
PAYMENT_TOKEN_VERSION=1
PAYMENT_PRICE_USD=0.02
# Optional per-product overrides. Amounts are atomic token units; USD values are display metadata.
# Empty values inherit PAYMENT_AMOUNT_ATOMIC / PAYMENT_PRICE_USD.
PAYMENT_AMOUNT_QUOTEPACK_ATOMIC=
PAYMENT_PRICE_QUOTEPACK_USD=
PAYMENT_AMOUNT_ELIGIBILITY_ATOMIC=
PAYMENT_PRICE_ELIGIBILITY_USD=
PAYMENT_AMOUNT_STATE_ATOMIC=
PAYMENT_PRICE_STATE_USD=
PAYMENT_AMOUNT_COMPARE_ATOMIC=
PAYMENT_PRICE_COMPARE_USD=
PAYMENT_AMOUNT_SIGNAL_ATOMIC=
PAYMENT_PRICE_SIGNAL_USD=
PAYMENT_AMOUNT_AGENTCALLS_ATOMIC=
PAYMENT_PRICE_AGENTCALLS_USD=
PAYMENT_AMOUNT_AGENTCALLSRECENT_ATOMIC=
PAYMENT_PRICE_AGENTCALLSRECENT_USD=
PAYMENT_AMOUNT_BSTOCKSNEWS_ATOMIC=
PAYMENT_PRICE_BSTOCKSNEWS_USD=
PAYMENT_AMOUNT_HISTORY_ATOMIC=
PAYMENT_PRICE_HISTORY_USD=
PAYMENT_AMOUNT_EVENTS_ATOMIC=
PAYMENT_PRICE_EVENTS_USD=
PAYMENT_AMOUNT_EXECUTABLESIZE_ATOMIC=
PAYMENT_PRICE_EXECUTABLESIZE_USD=
PAYMENT_AMOUNT_INTELLIGENCE_ATOMIC=
PAYMENT_PRICE_INTELLIGENCE_USD=
PAYMENT_AMOUNT_NEWS_ATOMIC=
PAYMENT_PRICE_NEWS_USD=
PAYMENT_AMOUNT_REASONING_ATOMIC=
PAYMENT_PRICE_REASONING_USD=
PAYMENT_AMOUNT_MCP_ATOMIC=
PAYMENT_PRICE_MCP_USD=
B402_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY=
# Optional buyer demo key. Keep it in your local .env only; never commit a funded key.
BUYER_PRIVATE_KEY=
# The dashboard demo is browser-local and never authorizes HTTP or MCP API calls.
HISTORY_FILE=data/history.jsonl
B402_REPLAY_FILE=data/b402-replay.json

# Signal brain and four-role intelligence council use an OpenAI-compatible endpoint when configured.
# Without credentials the deterministic, explicitly labeled fallback runs locally.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_REQUEST_TIMEOUT_MS=30000
# Bitget AI hackathon Qwen-compatible key. When set, provider defaults to qwen and
# base URL defaults to the Bitget hackathon gateway; override LLM_BASE_URL if needed.
BITGET_QWEN_API_KEY=
# Common Bitget hackathon model: qwen3.6-plus. Set the exact model issued for your key.
# OpenAI: set LLM_PROVIDER=openai, LLM_MODEL and OPENAI_API_KEY.
# Alibaba Qwen: set LLM_PROVIDER=qwen, LLM_MODEL, DASHSCOPE_API_KEY and the regional LLM_BASE_URL.
# Council calls News & Catalyst, Market Structure, and Adversarial Risk analysts, then a Council Judge.
# The service caches council output for 60 seconds; headlines remain untrusted evidence, not instructions.
# News filter aggregation: five provider routes are supported. Google News RSS is keyless;
# the other five only run when credentials are configured. Refresh is cached for five minutes.
NEWS_RSS_URL=
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_TOKEN=
FMP_API_KEY=
SIGNAL_WATCHLIST=NVDA,TSLA,QQQ
AGENT_CALLS_FILE=data/agent-calls.jsonl
